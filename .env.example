# ===== Discord accounts (self-bot tokens) =====
# NEVER commit real tokens. Copy this file to .env and fill in.
# Windows: token from Discord client devtools (Application > Local Storage > token)
DISCORD_TOKEN=your.discord.token.here

# Optional: extra accounts for multi-account mode (comma separated)
# Each entry maps to a profile name in the GUI / config
EXTRA_ACCOUNTS=alt1:token1,alt2:token2

# ===== Channels =====
# Numeric channel IDs where market activity is monitored / trades are placed
MARKET_CHANNEL_IDS=123456789012345678,123456789012345679
DAILY_BRIEFING_CHANNEL_ID=123456789012345678

# ===== DankAlert API (optional) =====
# Set DANKALERT_ENABLED=true and a base URL if you host/subscribe to an API
DANKALERT_ENABLED=false
DANKALERT_BASE_URL=
DANKALERT_API_KEY=

# ===== Runtime =====
DANKFLIP_CONFIG=config.yaml
DANKFLIP_DB=data/dankflipper.db
